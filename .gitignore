# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
# Local lounge database (dev visits, bans, uploads)
.data/

# Reproducible proxy runtimes and test artifacts
public/proxy-runtime/
.cache/
playwright-report/
test-results/
*.tsbuildinfo
public/game-runtime/
.next-build/

# Games vendor their own runtime deps (e.g. jQuery) under these paths and ship
# them as static assets — they must be committed or the game 404s in prod.
!public/games/*/node_modules/
!public/games/*/node_modules/**
# Deduplicated game masters, referenced by symlinks from public/games.
# They must be committed and must live outside public/ so Vercel's copier
# dereferences links instead of recursing into the tree it is copying.
!.game-assets-shared/
!.game-assets-shared/**
