# Vercel can run the main site and same-origin Bare HTTP API, but its
# serverless functions cannot host the persistent WebSocket upgrades required
# by Wisp. Leave WISP_URL unset for the clearly labeled HTTP-only fallback.
# For WebSockets/realtime traffic, run scripts/server.mjs --wisp-only on a
# persistent Node host behind TLS, then point the Vercel app at it:
# WISP_URL=wss://your-proxy-backend.example/wisp/
# WISP_ALLOWED_ORIGINS=https://your-gg-lounge.vercel.app
# PORT=3001

# Proxy origin checks accept forwarded host/protocol metadata in dev and on
# Vercel. A standalone production Node deployment must explicitly trust it only
# behind a reverse proxy that overwrites/sanitizes those headers. If that proxy
# strips them, list exact app origins instead (comma-separated; no paths or
# trailing slash). Do not set TRUST_PROXY_HEADERS when clients can reach the app
# directly or the proxy preserves untrusted client-supplied forwarding headers.
# TRUST_PROXY_HEADERS=1
# WISP_ALLOWED_ORIGINS=https://gg-lounge.example,https://gg-lounge.vercel.app

# Local `pnpm dev` serves Wisp and Next from the same Node process. Set this to
# 0 only when intentionally testing the HTTP-only transport locally.
# GG_LOCAL_WISP=0

# Diagnostics are automatic in development. In production they are opt-in via
# /proxy?proxyDebug=1 or localStorage.setItem('ggl-proxy-diagnostics', '1').
# Diagnostics are console-only and omit URLs, query strings, headers, cookies,
# request bodies and exception messages.
