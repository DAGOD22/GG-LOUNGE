# Vercel: configure a backend you control for full Scramjet transport support.
# Leave unset for explicitly labeled HTTP-only fallback (not full streaming).
# WISP_URL=wss://your-proxy-backend.example/wisp/

# Standalone persistent Wisp backend: explicitly allow the app's real origins.
# WISP_ALLOWED_ORIGINS=https://gg-lounge.vercel.app
# PORT=3001

# Self-hosted Node diagnostics only: set to 0 to choose HTTP instead of local Wisp.
# GG_LOCAL_WISP=0
