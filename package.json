{
  "name": "my-project",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/server.mjs --dev",
    "build": "next build",
    "start": "node scripts/server.mjs",
    "predev": "npm run prepare:customization && node scripts/prepare-proxy.mjs && node scripts/audit-games.mjs",
    "prebuild": "npm run prepare:customization && node scripts/prepare-proxy.mjs && node scripts/audit-games.mjs",
    "wisp": "node scripts/server.mjs --wisp-only",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "audit:games": "node scripts/audit-games.mjs",
    "prepare:customization": "esbuild scripts/customization-game.ts --bundle --minify --format=iife --target=es2020 --outfile=public/customization-game.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mercuryworkshop/bare-as-module3": "2.2.5",
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/libcurl-transport": "1.5.2",
    "@mercuryworkshop/scramjet": "1.1.0",
    "@mercuryworkshop/wisp-js": "0.4.1",
    "@nebula-services/bare-server-node": "^2.0.4",
    "@ruffle-rs/ruffle": "0.6.0",
    "@vercel/analytics": "1.6.1",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.7.3"
  }
}
