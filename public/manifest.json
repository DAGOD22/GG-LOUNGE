{
  "name": "GG-Lounge \u2014 Small games. Big energy.",
  "short_name": "GG Lounge",
  "description": "A handpicked, no-filler collection of browser games for the minutes between everything. Unblocked.",
  "start_url": "/?source=pwa",
  "id": "/",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "display": "standalone",
  "background_color": "#0b0d12",
  "theme_color": "#d7f34a",
  "orientation": "any",
  "scope": "/",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/placeholder-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "url": "/#games",
      "description": "Open game library"
    },
    {
      "name": "Proxy",
      "url": "/proxy",
      "description": "Unblocked browser"
    },
    {
      "name": "Apps",
      "url": "/apps",
      "description": "Unblocked apps"
    },
    {
      "name": "Play with a friend",
      "url": "/?coop=1",
      "description": "Open a co-op room"
    },
    {
      "name": "Customize",
      "url": "/?customize=1",
      "description": "Themes, cursors and the panic key"
    },
    {
      "name": "GG Tools",
      "url": "/tools",
      "description": "100 browser utilities"
    },
    {
      "name": "Request a game",
      "url": "/request-game",
      "description": "Ask for something to be added"
    },
    {
      "name": "GG-GPT",
      "url": "/gg-gpt",
      "description": "Ask the lounge's own assistant"
    }
  ]
}
